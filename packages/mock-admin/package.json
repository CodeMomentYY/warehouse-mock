  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/node": "^18.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.3.0",
    "tsx": "^3.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "antd": "^5.8.0",
    "@ant-design/icons": "^5.2.0",
    "axios": "^1.4.0"
  }
